# =====================================================================================================
# Astro Blog: the ONE settings template, for both local development and Docker Compose.
#
#   cp server/env.example server/.env    # local: read by `pnpm run dev` / `pnpm run dev:api` (the API)
#   cp server/env.example docker/.env    # Docker: read by docker compose and passed to the `server` container
#
# One KEY=value per line; comments on their own line only (no trailing "# ..."). Docker Compose
# expands `$` in docker/.env, so put a value that contains `$` in 'single quotes'.
# =====================================================================================================

# ---------------------------------------------------------------------------------------- Server
# In Docker, PORT and DATABASE_PATH are set by docker-compose.yml; the values here are ignored there.
PORT=3002
# Swagger UI for the API at /api/docs (and /api/docs-json). Default: on, except when NODE_ENV=production.
#SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------------- Database
# sqlite (default, a single file) or postgres. Schema changes (TypeORM migrations) apply at start-up.
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/astro-blog.db
# Postgres (only when DATABASE_TYPE=postgres).
#DATABASE_HOST=postgres
#DATABASE_PORT=5432
#DATABASE_USER=astroblog
#DATABASE_PASSWORD=
#DATABASE_NAME=astroblog

# ------------------------------------------------------------------------------------------ URLs
# Public website: confirm, manage and post links in e-mails point here.
PUBLIC_SITE_URL=http://localhost:4322
# Admin app: "Open in admin" and invite links in staff e-mails.
ADMIN_URL=http://localhost:5175
# Header carrying the real client IP (for rate limiting). nginx sets X-Real-IP; behind Cloudflare
# use cf-connecting-ip.
CLIENT_IP_HEADER=x-real-ip

# ------------------------------------------------------------------------------------------ Blog
# Used in e-mails until Settings → Blog name is saved in the admin.
BLOG_NAME=Acme Dev Blog
# The website's JSON feed of posts and topics. The API checks like/share/feedback slugs against it and
# builds new-post e-mails from it. Empty = <PUBLIC_SITE_URL>/feed.json. In Docker: http://website/feed.json.
SITE_FEED_URL=
# New-post e-mails go out in batches: this many per batch, then a pause (ms). Lower them if your SMTP
# provider throttles you.
DIGEST_BATCH_SIZE=20
DIGEST_BATCH_PAUSE_MS=1000

# ------------------------------------------------------------------------------------------ SMTP
# Local testing with Mailpit (http://localhost:8025): SMTP_PORT=1025, no user/password, and
# SMTP_HOST=mailpit in docker/.env (`docker compose --profile mail up -d`).
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (usually port 465). false = plain, upgraded with STARTTLS when offered (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender for every e-mail. Must be an address your SMTP provider allows you to send from.
MAIL_FROM="Acme Dev Blog <no-reply@blog.acme.example>"
# Who receives new-feedback notifications (comma-separated). Editable later in the admin (Settings).
NOTIFY_TO=editor@blog.acme.example
# Where readers' e-mail replies go (Reply-To). Empty = the first NOTIFY_TO address.
MAIL_REPLY_TO=

# ----------------------------------------------------------------------------------------- Admin
# Signs admin login tokens and the confirm / manage-subscription links in e-mails. Any random string of 32+ characters:
#   openssl rand -hex 32
# Keep it secret. Changing it logs every admin out and invalidates every confirm and unsubscribe link
# already e-mailed.
JWT_SECRET_KEY=<CHANGE_ME>
# How long an admin login lasts (8h, 30m, 1d, …).
JWT_TOKEN_EXPIRE_TIME=8h

# The first admin user is created from these on start-up, when the database has no user yet. The
# password is then stored bcrypt-hashed — remove ADMIN_PASSWORD from this file afterwards.
# Lock-out recovery: pnpm --dir server run admin:set-password <username>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<CHANGE_ME: at least 12 characters>
# Admin session cookie is Secure (HTTPS only; browsers also allow it on localhost). Set false only to
# test over plain http on a host other than localhost/127.0.0.1.
COOKIE_SECURE=true

# ------------------------------------------------------------------------------- Docker Compose
# Used only by docker/docker-compose.yml (docker/.env); `pnpm run dev` ignores them.

# Registry the images are pulled from, and the tag to run (latest, develop, manual or a version).
AB_REGISTRY=docker.allquill.com
AB_TAG=latest
# Interface and host ports. 127.0.0.1 = reachable only from this host (cloudflared / reverse proxy).
BIND_ADDRESS=127.0.0.1
WEBSITE_PORT=8093
ADMIN_PORT=8094
# BUILD arguments of the website image, used only by `docker compose up --build`: the public URL baked
# into canonical/OG links, and the GA4 measurement ID (blank = no analytics code).
SITE_URL=
GA_MEASUREMENT_ID=
# Host folder for container data: the server keeps its database in <folder>/server
# (mounted at /data). Relative to docker/. On Linux: sudo chown -R 1000:1000 <folder>. Back it up.
DOCKER_VOLUME_FOLDER=./volumes
