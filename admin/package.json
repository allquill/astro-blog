{
  "name": "astro-blog-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Admin app for the blog: dashboard, posts and their numbers, subscribers, feedback, new-post e-mails, users and settings. Talks to server/ through /api (Vite proxy in dev, nginx in Docker).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint . --max-warnings 0",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --port 5175 --strictPort",
    "sdk": "openapi --input ./openapi.json --output ./src/sdk --client fetch --useOptions --useUnionTypes"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "openapi-typescript-codegen": "^0.31.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
