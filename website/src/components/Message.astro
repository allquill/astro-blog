---
// A status box for the result pages of the no-JavaScript forms (and their JS equivalents).
interface Props {
  tone?: 'success' | 'error' | 'info';
  id?: string;
  hidden?: boolean;
}
const { tone = 'info', id, hidden } = Astro.props;
const tones = {
  success: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-200 dark:ring-emerald-900',
  error: 'bg-rose-50 text-rose-800 ring-rose-200 dark:bg-rose-950/40 dark:text-rose-200 dark:ring-rose-900',
  info: 'bg-sky-50 text-sky-800 ring-sky-200 dark:bg-sky-950/40 dark:text-sky-200 dark:ring-sky-900',
};
---
<div id={id} hidden={hidden} role={tone === 'error' ? 'alert' : 'status'} class:list={['rounded-xl px-4 py-3 text-sm ring-1', tones[tone]]}><slot /></div>
