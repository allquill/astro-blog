---
// The header logo: the site's mark in its brand colour (inline, so a colour change shows on the next page) and the name.
import { brandPalette, markSvg } from '../lib/brand';
import { getSettings } from '../lib/site';

interface Props {
  name: string;
}
const { name } = Astro.props;
const { brandColor } = await getSettings();
---
<a href="/" class="flex items-center gap-2.5 font-semibold text-slate-900 dark:text-white">
  <span class="size-8 shrink-0 [&>svg]:size-8" aria-hidden="true" set:html={markSvg(brandPalette(brandColor)[700])} />
  <span class="text-lg tracking-tight">{name}</span>
</a>
