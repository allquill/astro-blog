---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'size-5', strokeWidth = 1.75 } = Astro.props;
const paths = ICONS[name as IconName] ?? ICONS.book;
---
<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
