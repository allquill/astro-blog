---
// schema.org structured data. `<` is escaped so content can never close the script element.
interface Props {
  data: object | object[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---
{items.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
