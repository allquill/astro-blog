---
// A fenced code block: Shiki highlighting at build time (both themes are emitted and swapped with
// the .dark class, see global.css), a language/title bar, optional highlighted lines and a copy
// button. The page still shows the code without JavaScript; only "Copy" needs it.
import { Code } from 'astro:components';
import type { ShikiTransformer } from 'shiki';
import { bundledLanguages } from 'shiki/langs';

interface Props {
  content: string;
  language?: string;
  title?: string;
  /** "2,4-6": lines to highlight (1-based). */
  highlight?: string;
}
const { content, language = '', title = '', highlight = '' } = Astro.props;

const ALIASES: Record<string, string> = { sh: 'bash', shell: 'bash', zsh: 'bash', js: 'javascript', ts: 'typescript', yml: 'yaml', md: 'markdown', text: 'plaintext', txt: 'plaintext', '': 'plaintext' };
const lang = ALIASES[language] ?? language;
// An unknown language falls back to plain text rather than failing the build.
const known = lang === 'plaintext' || lang in bundledLanguages;
const code = content.replace(/\n$/, '');

const lines = new Set<number>();
for (const part of highlight.split(',')) {
  const [a, b] = part.split('-').map((n) => Number(n.trim()));
  if (!a) continue;
  for (let i = a; i <= (b || a); i++) lines.add(i);
}
const transformers: ShikiTransformer[] = lines.size
  ? [
      {
        name: 'highlight-lines',
        line(node, line) {
          if (lines.has(line)) this.addClassToHast(node, 'highlighted');
        },
      },
    ]
  : [];
const label = title || (language && language !== 'text' ? language : '');
---
<figure class="code-block not-prose group relative my-6 overflow-hidden rounded-xl ring-1 ring-slate-900/10 dark:ring-white/10">
  {label && (
    <figcaption class="flex items-center justify-between border-b border-slate-900/10 bg-slate-50 px-4 py-2 font-mono text-xs text-slate-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
      <span>{label}</span>
    </figcaption>
  )}
  <Code code={code} lang={known ? (lang as never) : 'plaintext'} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} transformers={transformers} />
  <button
    type="button"
    data-copy-code
    class:list={[
      'absolute right-2 rounded-md bg-white/90 px-2 py-1 text-xs font-medium text-slate-600 opacity-0 ring-1 ring-slate-900/10 transition group-hover:opacity-100 focus:opacity-100 dark:bg-slate-800/90 dark:text-slate-300 dark:ring-white/10',
      label ? 'top-1' : 'top-2',
    ]}
    hidden
  >Copy</button>
</figure>

<script>
  import { track } from '../../lib/analytics';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const code = button.closest('figure')?.querySelector('pre')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
        track('copy_code', { location: location.pathname });
      } catch {
        button.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
  }
</script>
