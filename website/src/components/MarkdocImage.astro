---
// Images inside post and page bodies. Uploaded images (/api/public/media/<id>) get responsive WebP
// copies from the API; any other URL is shown as it is.
import { mediaIdOf, mediaUrl, srcset } from '../lib/media';

interface Props {
  src: string;
  alt?: string;
  title?: string;
}
const { src, alt = '', title } = Astro.props;
const id = mediaIdOf(src);
---
{id ? (
  <img src={mediaUrl(id, 1280)} srcset={srcset(id, undefined, [640, 960, 1280, 1920])} sizes="(min-width: 768px) 768px, 100vw" alt={alt} title={title} loading="lazy" decoding="async" />
) : (
  <img src={src} alt={alt} title={title} loading="lazy" decoding="async" />
)}
