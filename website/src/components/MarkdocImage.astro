---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
}
const { src, alt = '', title } = Astro.props;
---
{typeof src === 'string' ? (
  <img src={src} alt={alt} title={title} loading="lazy" decoding="async" />
) : (
  <Image src={src} alt={alt} title={title} widths={[640, 960, 1280, 1600]} sizes="(min-width: 768px) 768px, 100vw" format="webp" quality={80} />
)}
