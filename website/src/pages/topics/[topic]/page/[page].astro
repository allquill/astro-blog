---
import ListPage from '../../../../components/ListPage.astro';
import { getSettings, topicsWithPosts } from '../../../../lib/site';
import { pageCount } from '../../../../lib/seo';

const settings = await getSettings();
const found = (await topicsWithPosts()).find((t) => t.topic.id === Astro.params.topic);
const page = Number(Astro.params.page);
if (!found || !Number.isInteger(page) || page < 2 || page > pageCount(found.posts.length, settings.postsPerPage)) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const { topic, posts } = found;
---
<ListPage
  title={topic.data.name}
  eyebrow="Topic"
  subtitle={topic.data.description || undefined}
  posts={posts}
  page={page}
  base={`/topics/${topic.id}/`}
  activeTopic={topic.id}
  subscribeTopics={[topic.id]}
  feeds={[{ title: `${topic.data.name} posts`, href: `/topics/${topic.id}/rss.xml` }]}
/>
