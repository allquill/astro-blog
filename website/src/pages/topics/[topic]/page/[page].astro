---
import ListPage from '../../../../components/ListPage.astro';
import { getSettings, topicsWithPosts, type Post, type Topic } from '../../../../lib/site';
import { pageCount } from '../../../../lib/seo';

export async function getStaticPaths() {
  const { postsPerPage } = await getSettings();
  return (await topicsWithPosts()).flatMap(({ topic, posts }) =>
    Array.from({ length: pageCount(posts.length, postsPerPage) - 1 }, (_, i) => ({ params: { topic: topic.id, page: String(i + 2) }, props: { topic, posts } })),
  );
}

interface Props {
  topic: Topic;
  posts: Post[];
}
const { topic, posts } = Astro.props;
---
<ListPage
  title={topic.data.name}
  eyebrow="Topic"
  subtitle={topic.data.description || undefined}
  posts={posts}
  page={Number(Astro.params.page)}
  base={`/topics/${topic.id}/`}
  activeTopic={topic.id}
  subscribeTopics={[topic.id]}
  feeds={[{ title: `${topic.data.name} posts`, href: `/topics/${topic.id}/rss.xml` }]}
/>
