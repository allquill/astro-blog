---
import ListPage from '../../../components/ListPage.astro';
import { topicsWithPosts } from '../../../lib/site';

// Only topics with at least one published post have a page.
const found = (await topicsWithPosts()).find((t) => t.topic.id === Astro.params.topic);
if (!found) return new Response(null, { status: 404, statusText: 'Not found' });
const { topic, posts } = found;
---
<ListPage
  title={topic.data.name}
  eyebrow="Topic"
  subtitle={topic.data.description || undefined}
  posts={posts}
  page={1}
  base={`/topics/${topic.id}/`}
  activeTopic={topic.id}
  subscribeTopics={[topic.id]}
  feeds={[{ title: `${topic.data.name} posts`, href: `/topics/${topic.id}/rss.xml` }]}
/>
