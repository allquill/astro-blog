---
import ListPage from '../../../components/ListPage.astro';
import { topicsWithPosts, type Post, type Topic } from '../../../lib/site';

// Only topics with at least one published post get a page.
export async function getStaticPaths() {
  return (await topicsWithPosts()).map(({ topic, posts }) => ({ params: { topic: topic.id }, props: { topic, posts } }));
}

interface Props {
  topic: Topic;
  posts: Post[];
}
const { topic, posts } = Astro.props;
---
<ListPage
  title={topic.data.name}
  eyebrow="Topic"
  subtitle={topic.data.description || undefined}
  posts={posts}
  page={1}
  base={`/topics/${topic.id}/`}
  activeTopic={topic.id}
  subscribeTopics={[topic.id]}
  feeds={[{ title: `${topic.data.name} posts`, href: `/topics/${topic.id}/rss.xml` }]}
/>
