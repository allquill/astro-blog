---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="container-page grid place-items-center py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl dark:text-white">Page not found</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">The page you were looking for has moved or never existed.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
