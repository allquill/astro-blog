---
import PostPage from '../../components/PostPage.astro';
import { getPosts } from '../../lib/site';

const posts = await getPosts();
const i = posts.findIndex((p) => p.id === Astro.params.slug);
if (i < 0) return new Response(null, { status: 404, statusText: 'Not found' });
---
<PostPage post={posts[i]!} newer={posts[i - 1] ?? null} older={posts[i + 1] ?? null} />
