---
import ListPage from '../../../components/ListPage.astro';
import { getPosts, getSettings } from '../../../lib/site';
import { pageCount } from '../../../lib/seo';

const settings = await getSettings();
const posts = await getPosts();
const page = Number(Astro.params.page);
// /blog/page/1/ is /blog/; pages past the end don't exist.
if (!Number.isInteger(page) || page < 2 || page > pageCount(posts.length, settings.postsPerPage)) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
---
<ListPage title="All posts" eyebrow="Blog" subtitle={settings.tagline || settings.description} posts={posts} page={page} base="/blog/" />
