---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getTags, getTopics } from '../../lib/site';

const tag = (await getTags()).find((t) => t.slug === Astro.params.tag);
if (!tag) return new Response(null, { status: 404, statusText: 'Not found' });
const { name, posts } = tag;
const topics = await getTopics();
---
<BaseLayout title={`#${name}`} description={`Posts tagged ${name}.`}>
  <PageHero eyebrow="Tag" title={`#${name}`} subtitle={`${posts.length} post${posts.length === 1 ? '' : 's'}`} back={{ href: '/topics/', label: 'All topics and tags' }} />
  <section class="container-page pt-4 pb-24"><PostGrid posts={posts} topics={topics} /></section>
</BaseLayout>
