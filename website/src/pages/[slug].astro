---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MarkdocContent from '../components/MarkdocContent.astro';
import { renderMarkdoc } from '../lib/markdoc';
import { getPage } from '../lib/site';

const page = await getPage(Astro.params.slug ?? '');
if (!page) return new Response(null, { status: 404, statusText: 'Not found' });
const { tree } = renderMarkdoc(page.body, `page:${page.revision}`);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero title={page.data.title} subtitle={page.data.description || undefined} />
  <article class="container-page pt-4 pb-16 sm:pb-24">
    <div class="prose prose-slate prose-lg max-w-none dark:prose-invert prose-headings:font-semibold prose-a:text-brand-700 prose-code:before:content-none prose-code:after:content-none dark:prose-a:text-brand-400">
      <MarkdocContent node={tree} />
    </div>
  </article>
</BaseLayout>
