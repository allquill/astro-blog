# =====================================================================================================
# Astro Blog — Docker Compose settings (docker-compose.yml and docker-compose-build.yml).
#
#   cp env.example .env        # in this folder (docker/.env), then fill in every <CHANGE_ME>
#
# Compose reads this file for the variables in the compose files (images, ports, folders), and passes
# all of it to the `server` container as its settings. For local development without Docker, use
# server/env.example (server/.env) instead.
#
# One KEY=value per line; comments on their own line only (no trailing "# ..."). Compose expands `$`,
# so put a value that contains `$` in 'single quotes'.
# =====================================================================================================

# --------------------------------------------------------------------------------------------- Images
# Prebuilt images (docker-compose.yml): registry and tag to pull — latest, develop, manual or a version
# such as 0.1.3. Ignored by docker-compose-build.yml, which builds and names images locally.
AB_REGISTRY=docker.allquill.com
AB_TAG=latest
# Tag for locally built images (docker-compose-build.yml).
AB_BUILD_TAG=local

# ------------------------------------------------------------------------------------- Host ports
# Interface the ports bind to. 127.0.0.1 = reachable only from this host (behind cloudflared or a
# reverse proxy); 0.0.0.0 = every interface.
BIND_ADDRESS=127.0.0.1
WEBSITE_PORT=8093
ADMIN_PORT=8094
# Mailpit's inbox (only with --profile mail). Its SMTP port stays on the private network (mailpit:1025).
MAILPIT_PORT=8025

# ------------------------------------------------------------------------------------------- Data
# Host folder for container data, relative to docker/: the SQLite database in <folder>/server, Postgres
# in <folder>/postgres. On Linux: sudo chown -R 1000:1000 <folder>. Back it up.
DOCKER_VOLUME_FOLDER=./volumes

# ----------------------------------------------------------------------- Website build (build file only)
# Baked into the website image by docker-compose-build.yml. Prebuilt images get theirs from CI (the
# SITE_URL / GA_MEASUREMENT_ID repository variables), so these have no effect on docker-compose.yml.
# Public URL of the blog: canonical and share links, sitemap, and the post links in new-post e-mails.
SITE_URL=
# Google Analytics 4 measurement ID (G-…). Empty = no analytics code. See docs/analytics.md.
GA_MEASUREMENT_ID=

# ----------------------------------------------------------------------------------------- Database
# sqlite (default: a single file in DOCKER_VOLUME_FOLDER/server) or postgres. For postgres, also start
# with `--profile postgres`; the compose file then creates the database from the DATABASE_* values below.
DATABASE_TYPE=sqlite
#DATABASE_HOST=postgres
#DATABASE_PORT=5432
#DATABASE_USER=astroblog
#DATABASE_PASSWORD=<CHANGE_ME>
#DATABASE_NAME=astroblog

# --------------------------------------------------------------------------------------------- URLs
# Public website and admin addresses: confirm/manage/post links in e-mails, and "Open in admin" and
# invite links in staff e-mails. Locally: http://localhost:8093 and http://localhost:8094.
PUBLIC_SITE_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
# Header carrying the real client IP (rate limiting, like dedupe). The nginx containers set X-Real-IP;
# behind Cloudflare (tunnel or proxy) use cf-connecting-ip.
CLIENT_IP_HEADER=x-real-ip
# The site's JSON feed of posts and topics. Empty = the website container (http://website/feed.json).
SITE_FEED_URL=

# --------------------------------------------------------------------------------------------- Blog
# Used in e-mails until Settings → Blog name is saved in the admin.
BLOG_NAME=Acme Dev Blog
# New-post e-mails go out in batches: this many per batch, then a pause (ms). Match your SMTP
# provider's rate limit.
DIGEST_BATCH_SIZE=20
DIGEST_BATCH_PAUSE_MS=1000

# --------------------------------------------------------------------------------------------- SMTP
# Testing with Mailpit (`--profile mail`, inbox at http://localhost:8025): SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_SECURE=false, no user/password.
SMTP_HOST=<CHANGE_ME>
SMTP_PORT=587
# true = implicit TLS (usually port 465). false = plain, upgraded with STARTTLS when offered (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender for every e-mail. Must be an address your SMTP provider allows you to send from.
MAIL_FROM="Acme Dev Blog <no-reply@blog.acme.example>"
# Who receives new-feedback notifications (comma-separated). Editable later in the admin (Settings).
NOTIFY_TO=editor@blog.acme.example
# Where readers' e-mail replies go (Reply-To). Empty = the first NOTIFY_TO address.
MAIL_REPLY_TO=

# -------------------------------------------------------------------------------------------- Admin
# Signs admin logins and the confirm / manage-subscription links in e-mails. Generate with:
#   openssl rand -hex 32
# Keep it secret. Changing it logs every admin out and invalidates every link already e-mailed.
JWT_SECRET_KEY=<CHANGE_ME>
# How long an admin login lasts (8h, 30m, 1d, …).
JWT_TOKEN_EXPIRE_TIME=8h
# The first admin is created from these on the first start, when the database has no user yet. The
# password (12+ characters) is stored bcrypt-hashed; remove ADMIN_PASSWORD from this file afterwards.
# Lock-out recovery: docker compose exec server node dist/cli/set-password.js admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<CHANGE_ME: at least 12 characters>
# The admin cookie is Secure (HTTPS only; browsers also allow it on localhost). Set false only to reach
# the admin over plain http on another host name, e.g. http://192.168.1.10:8094.
COOKIE_SECURE=true
# Swagger UI at /api/docs is off in the images (NODE_ENV=production). The API isn't published on the
# host, so it is only reachable from inside the network anyway.
#SWAGGER_ENABLED=true

# --------------------------------------------------------------------------------- Cloudflare Tunnel
# Only with `--profile cloudflare`. Create a tunnel in Cloudflare Zero Trust → Networks → Tunnels
# (Docker), copy its token here, and route its public hostnames to http://website:80 and
# http://admin:80. Then set PUBLIC_SITE_URL / ADMIN_URL above to those hostnames and
# CLIENT_IP_HEADER=cf-connecting-ip.
CLOUDFLARE_TUNNEL_TOKEN=
#CLOUDFLARED_VERSION=2026.10.3
